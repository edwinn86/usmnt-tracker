{
  "name": "usmnt-tracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "discover-players": "node scripts/manage-players.mjs --discover",
    "discover-players:no-mls": "node scripts/manage-players.mjs --discover --exclude-mls",
    "manage-players": "node scripts/manage-players.mjs",
    "refresh-data": "node scripts/refresh-snapshots.mjs",
    "refresh-data:all": "node scripts/refresh-snapshots.mjs --refresh-history",
    "resolve-ids": "node scripts/resolve-player-ids.mjs",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist -r https://github.com/edwinn86/usmnt-tracker.git"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "gh-pages": "^6.3.0",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
