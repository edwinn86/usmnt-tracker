@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Oswald:wght@600;700&display=swap');

/* Base */
*, *::before, *::after {
  box-sizing: border-box;
}

html, 
body, 
#root, 
#app, 
main {
  background-color: #060a12 !important;
  color: #f8fafc;
  margin: 0;
  padding: 0;
  width: 100%;
  min-height: 100vh;
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  -webkit-font-smoothing: antialiased;
}

/* Header */
.app-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28px 24px 24px;
  max-width: 1280px;
  margin: 0 auto;
  width: 100%;
  flex-wrap: wrap;
  gap: 20px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.brand {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.brand h1 {
  font-family: 'Oswald', sans-serif;
  font-size: 2rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 2.5px;
  margin: 0;
  color: #ffffff;
  line-height: 0.9;
  text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
}

.brand .subtitle {
  font-size: 0.725rem;
  color: #64748b;
  text-transform: uppercase;
  letter-spacing: 1.5px;
  font-weight: 600;
  margin-top: 4px;
}

/* Tabs */
.tab-bar {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
}

.tab-button {
  background: rgba(15, 23, 42, 0.6);
  border: 1px solid rgba(255, 255, 255, 0.12);
  color: #94a3b8;
  padding: 10px 18px;
  border-radius: 9999px;
  font-family: 'Oswald', sans-serif;
  font-weight: 600;
  text-transform: uppercase;
  font-size: 0.9rem;
  letter-spacing: 1px;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  transition: all 0.25s ease;
}

.tab-button:hover {
  border-color: #2563eb;
  color: #ffffff;
  background: rgba(37, 99, 235, 0.2);
}

.tab-button.active {
  background: linear-gradient(135deg, #1d4ed8 0%, #1e40af 100%);
  border-color: #3b82f6;
  color: #ffffff;
  box-shadow: 0 4px 14px rgba(29, 78, 216, 0.4);
}

.tab-button .badge {
  background: rgba(0, 0, 0, 0.35);
  padding: 2px 8px;
  border-radius: 12px;
  font-size: 0.75rem;
  font-family: 'Inter', sans-serif;
  color: #cbd5e1;
  font-weight: 600;
}

.tab-button.active .badge {
  background: rgba(255, 255, 255, 0.22);
  color: #ffffff;
}

/* Roster */
.player-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 28px;
  padding: 32px 24px 60px;
  max-width: 1280px;
  margin: 0 auto;
  width: 100%;
}

.player-carousel-shell {
  position: relative;
}

.roster-view-stage {
  min-width: 0;
}

.roster-view-stage .player-carousel-shell,
.roster-view-stage .mobile-compact-list {
  animation: none;
}

.mobile-swipe-hint {
  display: none;
}

.mobile-filter-bar,
.mobile-filter-dialog,
.mobile-compact-list {
  display: none;
}

.roster-tools {
  display: flex;
  align-items: end;
  gap: 12px;
  max-width: 1280px;
  margin: 20px auto -8px;
  padding: 0 24px;
}

.roster-tools label {
  display: flex;
  flex-direction: column;
  gap: 5px;
  color: #718096;
  font-size: 0.63rem;
  font-weight: 700;
  letter-spacing: 0.07em;
  text-transform: uppercase;
}

.roster-tools input,
.roster-tools select {
  height: 34px;
  border: 1px solid rgba(255, 255, 255, 0.16);
  border-radius: 7px;
  background: rgba(15, 23, 42, 0.78);
  color: #e2e8f0;
  font-family: 'Inter', sans-serif;
  font-size: 0.78rem;
  font-weight: 600;
  outline: none;
}

.roster-tools input:focus,
.roster-tools select:focus {
  border-color: #3b82f6;
  box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.16);
}

.roster-search { flex: 0 1 260px; }
.roster-search input { width: 100%; padding: 0 10px; }
.roster-select { flex: 0 1 170px; min-width: 130px; }
.roster-select select { width: 100%; padding: 0 8px; }

.rating-filter {
  flex: 0 1 164px;
  min-width: 140px;
}

.rating-filter span {
  display: flex;
  justify-content: space-between;
}

.rating-filter strong { color: #dbeafe; }

.rating-filter input[type='range'] {
  width: 100%;
  height: 5px;
  margin: 14px 0 15px;
  border: 0;
  border-radius: 999px;
  background: linear-gradient(90deg, #f87171 0%, #fb923c 32%, #facc15 48%, #4ade80 71%, #6ee7b7 100%);
  cursor: pointer;
  appearance: none;
  -webkit-appearance: none;
}

.rating-filter input[type='range']::-webkit-slider-thumb {
  width: 15px;
  height: 15px;
  border: 2px solid #0f172a;
  border-radius: 50%;
  background: var(--rating-color);
  box-shadow: 0 0 8px color-mix(in srgb, var(--rating-color), transparent 45%);
  -webkit-appearance: none;
}

.rating-filter input[type='range']::-moz-range-thumb {
  width: 12px;
  height: 12px;
  border: 2px solid #0f172a;
  border-radius: 50%;
  background: var(--rating-color);
  box-shadow: 0 0 8px color-mix(in srgb, var(--rating-color), transparent 45%);
}

.roster-count {
  display: inline-flex;
  align-self: flex-end;
  align-items: center;
  min-height: 34px;
  padding: 0 9px;
  border-right: 1px solid rgba(255, 255, 255, 0.1);
  color: #64748b;
  font-size: 0.68rem;
  font-weight: 700;
  white-space: nowrap;
}

.desktop-card-hint {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  color: #718096;
  font-size: 0.64rem;
  font-weight: 600;
  letter-spacing: 0.02em;
  white-space: nowrap;
}

.desktop-card-hint svg {
  width: 15px;
  height: 15px;
  fill: none;
  stroke: #60a5fa;
  stroke-linecap: round;
  stroke-width: 1.7;
}

.roster-view-control {
  display: flex;
  flex: 0 0 auto;
  flex-direction: column;
  gap: 5px;
  color: #718096;
  font-size: 0.63rem;
  font-weight: 700;
  letter-spacing: 0.07em;
  text-transform: uppercase;
}

.roster-summary {
  display: flex;
  min-height: 34px;
  flex: 1 1 auto;
  align-items: center;
  justify-content: flex-end;
  gap: 9px;
  padding-top: 13px;
}

.view-toggle {
  display: inline-flex;
  flex: 0 0 auto;
  align-self: end;
  padding: 3px;
  border: 1px solid rgba(255, 255, 255, 0.14);
  border-radius: 8px;
  background: rgba(15, 23, 42, 0.78);
}

.view-toggle button {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  min-height: 26px;
  padding: 4px 10px;
  border: 0;
  border-radius: 5px;
  background: transparent;
  color: #718096;
  cursor: pointer;
  font-family: 'Inter', sans-serif;
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

.view-toggle button svg {
  width: 13px;
  height: 13px;
  fill: none;
  stroke: currentColor;
  stroke-linecap: round;
  stroke-linejoin: round;
  stroke-width: 1.8;
}

.view-toggle button svg rect {
  fill: currentColor;
  stroke: none;
}

.view-toggle button:hover { color: #dbeafe; }

.view-toggle button.active {
  background: #1d4ed8;
  color: #fff;
  box-shadow: 0 2px 8px rgba(29, 78, 216, 0.35);
}

.player-table-shell {
  width: calc(100% - 48px);
  max-width: 1232px;
  margin: 32px auto 60px;
  overflow-x: auto;
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 14px;
  background: linear-gradient(165deg, rgba(13, 24, 56, 0.8), rgba(7, 13, 30, 0.9));
  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.35);
}

.player-table {
  width: 100%;
  min-width: 920px;
  border-collapse: collapse;
  color: #cbd5e1;
  font-size: 0.78rem;
}

.player-table th,
.player-table td {
  padding: 12px 14px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  text-align: left;
  white-space: nowrap;
}

.player-table thead th {
  position: sticky;
  top: 0;
  z-index: 1;
  background: #0c1630;
  color: #64748b;
  font-size: 0.63rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.table-sort-button {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 3px 0;
  border: 0;
  background: transparent;
  color: inherit;
  cursor: pointer;
  font: inherit;
  font-weight: inherit;
  letter-spacing: inherit;
  text-transform: inherit;
}

.player-table thead .numeric-column .table-sort-button {
  justify-content: flex-end;
  width: 100%;
}

.table-sort-button:hover,
.table-sort-button:focus-visible {
  color: #bfdbfe;
  outline: none;
}

.table-sort-arrow {
  width: 9px;
  color: #334155;
  font-size: 0.72rem;
  line-height: 1;
}

.table-sort-arrow.active {
  color: #60a5fa;
}

.player-table thead .table-details-heading {
  text-align: center;
}

.player-table tbody tr:last-child > * { border-bottom: 0; }
.player-table tbody tr:hover { background: rgba(59, 130, 246, 0.08); }
.player-table tbody th { color: #fff; font-weight: 600; }
.player-table .numeric-column { text-align: right; }

.table-player {
  display: flex;
  align-items: center;
  gap: 11px;
}

.table-player-button {
  width: 100%;
  padding: 0;
  border: 0;
  background: transparent;
  color: inherit;
  cursor: pointer;
  text-align: left;
}

.table-player-button:hover strong,
.table-player-button:focus-visible strong {
  color: #93c5fd;
}

.table-player-button:focus-visible {
  border-radius: 6px;
  outline: 2px solid rgba(96, 165, 250, 0.55);
  outline-offset: 3px;
}

.table-player img {
  width: 42px;
  height: 42px;
  object-fit: cover;
  border: 1px solid rgba(255, 255, 255, 0.16);
  border-radius: 50%;
  background: #101a33;
}

.table-player span {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.table-player strong {
  font-family: 'Oswald', sans-serif;
  font-size: 0.91rem;
  letter-spacing: 0.02em;
  text-transform: uppercase;
}

.table-player small { color: #718096; font-size: 0.68rem; font-weight: 500; }

.table-position {
  color: #93c5fd;
  font-size: 0.66rem;
  font-weight: 700;
  letter-spacing: 0.035em;
  text-transform: uppercase;
}

.table-value { color: #fff; font-weight: 700; }

.table-rating {
  display: inline-flex;
  min-width: 48px;
  min-height: 27px;
  align-items: center;
  justify-content: center;
  padding: 3px 7px;
  border-radius: 6px;
  font-weight: 700;
}

.table-stats-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  min-width: 32px;
  height: 32px;
  min-height: 32px;
  padding: 0;
  border: 1px solid rgba(96, 165, 250, 0.28);
  border-radius: 50%;
  background: rgba(29, 78, 216, 0.08);
  color: #93c5fd;
  cursor: pointer;
  font-family: 'Inter', sans-serif;
  font-size: 0.67rem;
  font-weight: 700;
  white-space: nowrap;
}

.table-stats-button span {
  font-size: 1.12rem;
  line-height: 0.7;
  transition: transform 0.18s ease;
}

.table-stats-button:hover,
.table-stats-button:focus-visible {
  border-color: #60a5fa;
  background: rgba(29, 78, 216, 0.32);
  color: #fff;
  box-shadow: 0 0 10px rgba(59, 130, 246, 0.2);
  outline: none;
}

.table-stats-button:hover span,
.table-stats-button:focus-visible span {
  transform: translateX(2px);
}

.visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

.player-stats-dialog {
  position: fixed;
  inset: 0;
  z-index: 50;
  display: grid;
  place-items: center;
  padding: 24px;
}

.player-stats-backdrop {
  position: absolute;
  inset: 0;
  border: 0;
  background: rgba(2, 6, 23, 0.82);
  backdrop-filter: blur(5px);
  cursor: default;
}

.player-stats-panel {
  position: relative;
  z-index: 1;
  width: min(360px, calc(100vw - 32px));
  animation: stats-dialog-in 0.2s ease-out;
}

.player-stats-panel .flip-container {
  width: 100%;
  cursor: default;
}

.player-stats-panel .flip-container:hover,
.player-stats-panel .flip-container.is-active {
  transform: none;
}

.player-stats-close {
  position: absolute;
  top: -14px;
  right: -14px;
  z-index: 5;
  display: grid;
  width: 36px;
  height: 36px;
  place-items: center;
  padding: 0 0 2px;
  border: 1px solid rgba(147, 197, 253, 0.5);
  border-radius: 50%;
  background: #111c38;
  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.45);
  color: #fff;
  cursor: pointer;
  font-size: 1.35rem;
  line-height: 1;
}

.player-stats-close:hover,
.player-stats-close:focus-visible {
  border-color: #60a5fa;
  background: #1e3a8a;
  outline: none;
}

@keyframes stats-dialog-in {
  from { opacity: 0; transform: translateY(12px) scale(0.97); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

/* Player card */
.player-card {
  background: linear-gradient(165deg, #0d1838 0%, #070d1e 100%);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 20px;
  overflow: hidden;
  position: relative;
  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.6);
  transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  color: #ffffff;
  min-height: 440px;
}

.player-card:hover,
.player-card.is-active {
  transform: translateY(-8px);
  box-shadow: 0 22px 40px rgba(0, 0, 0, 0.8), 0 0 20px rgba(37, 99, 235, 0.3);
  border-color: rgba(59, 130, 246, 0.5);
}

.player-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 5px;
  background: linear-gradient(90deg, #dc2626 0%, #ffffff 50%, #2563eb 100%);
  z-index: 2;
}

.player-photo {
  width: 130px;
  height: 130px;
  object-fit: cover;
  pointer-events: none;
  -webkit-user-drag: none;
  border-radius: 50%;
  margin-top: 28px;
  margin-bottom: 12px;
  background: radial-gradient(circle, #1e293b 0%, #0b1329 100%);
  border: 2px solid rgba(255, 255, 255, 0.2);
  box-shadow: 
    -4px 0 12px rgba(37, 99, 235, 0.35),
     4px 0 12px rgba(220, 38, 38, 0.35);
}

.player-card h2 {
  font-family: 'Oswald', sans-serif;
  font-size: 1.35rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.3px;
  margin: 12px 8px 7px;
  color: #ffffff;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.player-card .position {
  align-self: center;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  width: calc(100% - 56px);
  color: #a5b4d4;
  font-family: 'Inter', sans-serif;
  font-size: 0.62rem;
  font-weight: 700;
  line-height: 1;
  text-transform: uppercase;
  letter-spacing: 0.09em;
  margin: 16px 28px 10px;
  padding: 0;
}

.player-card .position::before,
.player-card .position::after {
  height: 1px;
  flex: 1;
  background: linear-gradient(90deg, transparent, rgba(148, 163, 184, 0.28));
  content: '';
}

.player-card .position::after {
  transform: rotate(180deg);
}

.player-card .league {
  font-size: 0.8rem;
  font-weight: 700;
  text-transform: uppercase;
  color: #93c5fd;
  letter-spacing: 1px;
  margin: 0 16px 4px;
  line-height: 1.2;
}

.player-card .team {
  font-size: 0.86rem;
  color: #94a3b8;
  margin: 0 16px;
  line-height: 1.2;
}

.vitals {
  display: flex;
  gap: 10px;
  align-items: center;
  margin-bottom: 18px;
  transform: translateY(8px);
}

.vital {
  display: inline-flex;
  align-items: baseline;
  gap: 5px;
}

.vital-label {
  color: #64748b;
  font-size: 0.58rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.vital-value {
  color: #cbd5e1;
  font-size: 0.82rem;
  font-weight: 600;
}

.vitals .divider {
  width: 3px;
  height: 3px;
  border-radius: 50%;
  background: #475569;
  font-size: 0;
}

/* Card summary */
.stats {
  width: 100%;
  display: grid;
  grid-template-columns: 1.15fr 0.925fr 0.925fr 0.95fr;
  background-color: rgba(0, 0, 0, 0.35);
  border-top: 1px solid rgba(255, 255, 255, 0.08);
  margin-top: auto;
}

.stat {
  padding: 14px 2px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
}

.stat:not(:last-child) {
  border-right: 1px solid rgba(255, 255, 255, 0.08);
}

.stat-label {
  font-size: 0.6rem;
  text-transform: uppercase;
  color: #64748b;
  font-weight: 700;
  letter-spacing: 0px;
  margin-bottom: 8px;
}

.stat-output .stat-label {
  font-size: 0.58rem;
}

.stat-output {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  width: 100%;
  padding-inline: 0;
}

.output-stat {
  display: flex;
  min-width: 0;
  flex-direction: column;
  align-items: center;
}

.output-stat + .output-stat {
  border-left: 1px solid rgba(255, 255, 255, 0.1);
}

.stat-value {
  font-size: 0.95rem;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: -0.02em;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 28px; 
}

.stat-rating {
  box-sizing: border-box;
  justify-content: center;
  width: 54px;
  padding: 3px 9px;
  border-radius: 6px;
  font-size: 0.98rem;
  font-weight: 700;
  letter-spacing: normal;
  min-height: auto;
  margin-top: -1px;
  transform: translateY(-2px);
}

.rating-t1 {
  background: rgba(4, 120, 87, 0.45);
  color: #6ee7b7;
  border: 1px solid rgba(52, 211, 153, 0.8);
  box-shadow: 0 0 12px rgba(16, 185, 129, 0.4);
}

.rating-t2 {
  background: rgba(34, 197, 94, 0.15);
  color: #4ade80;
  border: 1px solid rgba(34, 197, 94, 0.35);
}

.rating-t3 {
  background: rgba(234, 179, 8, 0.15);
  color: #facc15;
  border: 1px solid rgba(234, 179, 8, 0.35);
}

.rating-t4 {
  background: rgba(249, 115, 22, 0.15);
  color: #fb923c;
  border: 1px solid rgba(249, 115, 22, 0.35);
}

.rating-t5 {
  background: rgba(239, 68, 68, 0.15);
  color: #f87171;
  border: 1px solid rgba(239, 68, 68, 0.35);
}

.rating-none {
  background: rgba(255, 255, 255, 0.1);
  color: #94a3b8;
  border: 1px solid rgba(255, 255, 255, 0.15);
}

/* Loading */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80px 24px;
  min-height: 400px;
  width: 100%;
}

.spinner {
  width: 48px;
  height: 48px;
  border: 4px solid rgba(255, 255, 255, 0.1);
  border-left-color: #2563eb;
  border-top-color: #dc2626;
  border-radius: 50%;
  animation: spin 0.9s cubic-bezier(0.55, 0.15, 0.45, 0.85) infinite;
  box-shadow: 0 0 15px rgba(37, 99, 235, 0.3);
  margin-bottom: 18px;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-family: 'Oswald', sans-serif;
  font-size: 1.1rem;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: #94a3b8;
  margin: 0;
  display: inline-flex;
  align-items: baseline; 
}

.loading-text .dot {
  display: inline-block;
  color: #3b82f6;
  font-size: 1.2rem;
  font-weight: bold;
  animation: wave 1.4s infinite ease-in-out both;
}

.loading-text .dot-1 { animation-delay: 0s; }
.loading-text .dot-2 { animation-delay: 0.2s; }
.loading-text .dot-3 { animation-delay: 0.4s; }

@keyframes wave {
  0%, 80%, 100% {
    transform: translateY(0);
    opacity: 0.3;
  }
  40% {
    transform: translateY(-5px);
    opacity: 1;
    color: #60a5fa;
  }
}

.status-message {
  text-align: center;
  padding: 60px 24px;
  color: #64748b;
  font-family: 'Oswald', sans-serif;
  letter-spacing: 1px;
}

/* ==========================================
   8. MEDIA QUERIES (TABLET & MOBILE)
   ========================================== */

/* Tablet (Under 1024px) */
@media (max-width: 1024px) {
  .player-grid {
    grid-template-columns: repeat(2, 1fr) !important;
    gap: 16px;
    padding: 20px 16px;
  }

  .app-header {
    padding: 20px 16px 16px;
  }
}

/* Tablet / small laptop: preserve the desktop controls without crushing them
   into a single row (Surface Pro portrait is 912 CSS pixels wide). */
@media (min-width: 641px) and (max-width: 1024px) {
  .roster-tools {
    flex-wrap: wrap;
    row-gap: 10px;
    margin-top: 16px;
    padding-inline: 16px;
  }

  .roster-search {
    flex: 1 1 190px;
  }

  .roster-select {
    flex: 1 1 145px;
  }

  .rating-filter {
    flex: 1 1 155px;
  }

  .roster-count {
    border-right: 0;
  }

  .roster-summary {
    flex: 1 1 210px;
    justify-content: flex-start;
    padding-top: 13px;
  }
}

@media (min-width: 641px) and (max-width: 820px) {
  .desktop-card-hint {
    display: none;
  }
}

/* Mobile (Under 640px) */
@media (max-width: 640px), (orientation: landscape) and (max-height: 500px) and (max-width: 950px) {
  .roster-tools {
    display: none;
  }

  .mobile-filter-bar {
    position: absolute;
    top: 15px;
    right: 5vw;
    z-index: 6;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 6px;
    width: auto;
    margin: 0;
    padding: 0;
  }

  .player-table-shell {
    display: none;
  }

  .player-table {
    display: block;
    width: 100%;
    min-width: 0;
  }

  .player-table thead {
    display: none;
  }

  .player-table tbody {
    display: block;
    width: 100%;
  }

  .player-table tbody tr {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    column-gap: 8px;
    align-items: center;
    width: 100%;
    padding: 9px 10px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }

  .player-table tbody tr:last-child {
    border-bottom: 0;
  }

  .player-table th,
  .player-table td {
    display: none;
    min-width: 0;
    padding: 0;
    border: 0;
  }

  .player-table tbody th {
    display: block;
    grid-column: 1;
    grid-row: 1;
  }

  .player-table tbody td:nth-child(7) {
    display: block;
    grid-column: 2;
    grid-row: 1;
  }

  .player-table tbody td:nth-child(10) {
    display: block;
    grid-column: 3;
    grid-row: 1;
  }

  .table-player {
    gap: 10px;
    min-width: 0;
  }

  .table-player img {
    flex: 0 0 auto;
    width: 34px;
    height: 34px;
  }

  .table-player span {
    min-width: 0;
  }

  .table-player strong,
  .table-player small {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .table-player strong {
    font-size: 0.8rem;
  }

  .table-player small {
    margin-top: 1px;
    font-size: 0.6rem;
  }

  .table-rating {
    min-width: 45px;
    min-height: 25px;
    padding: 2px 6px;
    font-size: 0.7rem;
  }

.table-stats-button {
    min-width: 28px;
    min-height: 28px;
    padding: 2px 7px;
    border-radius: 50%;
  }

  .table-stats-label {
    display: none;
  }

  .table-stats-arrow {
    font-size: 1.05rem;
  }

  .player-stats-dialog {
    align-items: center;
    padding: 16px;
  }

  .player-stats-panel {
    width: min(90vw, 390px);
  }

  .player-stats-panel .flip-container {
    flex-basis: auto;
    width: 100%;
  }

  .player-stats-panel .player-card {
    min-height: min(594px, calc(100svh - 56px)) !important;
  }

  .player-stats-close {
    top: -10px;
    right: -8px;
  }

  .mobile-filter-trigger {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 32px;
    padding: 5px 9px;
    border: 1px solid rgba(147, 197, 253, 0.42);
    border-radius: 999px;
    background: linear-gradient(135deg, rgba(30, 58, 138, 0.5), rgba(15, 23, 42, 0.9));
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.22);
    color: #dbeafe;
    font-family: 'Inter', sans-serif;
    font-size: 0.67rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    transition: transform 0.18s ease, border-color 0.18s ease, background 0.18s ease;
  }

  .mobile-view-trigger {
    display: grid;
    width: 35px;
    height: 35px;
    flex: 0 0 auto;
    place-items: center;
    padding: 0;
    border: 1px solid rgba(147, 197, 253, 0.34);
    border-radius: 9px;
    background: rgba(15, 23, 42, 0.88);
    color: #93c5fd;
    cursor: pointer;
  }

  .mobile-view-trigger.active {
    border-color: #3b82f6;
    background: #1d4ed8;
    color: #fff;
  }

  .mobile-view-trigger svg {
    width: 19px;
    height: 19px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  .mobile-view-trigger svg rect {
    fill: currentColor;
    stroke: none;
  }

  .mobile-view-trigger:focus-visible {
    outline: 2px solid #60a5fa;
    outline-offset: 2px;
  }

  .mobile-filter-trigger:active {
    transform: scale(0.96);
  }

  .mobile-filter-trigger:focus-visible {
    outline: 2px solid #60a5fa;
    outline-offset: 2px;
  }

  .mobile-filter-icon {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: #93c5fd;
    stroke-linecap: round;
    stroke-width: 2;
  }

  .mobile-filter-count {
    display: grid;
    min-width: 18px;
    height: 18px;
    place-items: center;
    border-radius: 999px;
    background: #3b82f6;
    color: #fff;
    font-size: 0.65rem;
  }

  .mobile-result-count {
    display: none;
  }

  .mobile-filter-dialog {
    position: fixed;
    inset: 0;
    z-index: 30;
    display: flex;
    align-items: flex-end;
  }

  .mobile-filter-backdrop {
    position: absolute;
    inset: 0;
    border: 0;
    background: rgba(2, 6, 23, 0.7);
  }

  .mobile-filter-sheet {
    position: relative;
    z-index: 1;
    width: 100%;
    padding: 12px 18px calc(18px + env(safe-area-inset-bottom));
    border: 1px solid rgba(147, 197, 253, 0.25);
    border-radius: 18px 18px 0 0;
    background: #0b1329;
    box-shadow: 0 -16px 40px rgba(0, 0, 0, 0.42);
    animation: mobile-filter-sheet-in 0.22s ease-out;
  }

  .mobile-filter-sheet-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 15px;
  }

  .mobile-filter-sheet-header h2 {
    margin: 0;
    color: #f8fafc;
    font-family: 'Oswald', sans-serif;
    font-size: 1.15rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .mobile-filter-close {
    width: 30px;
    height: 30px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 50%;
    background: transparent;
    color: #cbd5e1;
    font-size: 1.35rem;
    line-height: 1;
  }

  .mobile-filter-field,
  .mobile-rating-filter {
    display: flex;
    flex-direction: column;
    gap: 6px;
    color: #94a3b8;
    font-size: 0.63rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .mobile-filter-field input,
  .mobile-filter-field select {
    width: 100%;
    height: 38px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 7px;
    background: rgba(15, 23, 42, 0.92);
    color: #e2e8f0;
    font-family: 'Inter', sans-serif;
    font-size: 0.78rem;
    font-weight: 600;
    outline: none;
  }

  .mobile-filter-field input { padding: 0 10px; }
  .mobile-filter-field select { padding: 0 8px; }
  .mobile-filter-search { margin-bottom: 12px; }

  .mobile-filter-pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-bottom: 16px;
  }

  .mobile-rating-filter span {
    display: flex;
    justify-content: space-between;
  }

  .mobile-rating-filter input[type='range'] {
    width: 100%;
    height: 5px;
    margin: 10px 0 12px;
    border: 0;
    border-radius: 999px;
    background: linear-gradient(90deg, #f87171 0%, #fb923c 32%, #facc15 48%, #4ade80 71%, #6ee7b7 100%);
    cursor: pointer;
    appearance: none;
    -webkit-appearance: none;
  }

  .mobile-rating-filter input[type='range']::-webkit-slider-thumb {
    width: 17px;
    height: 17px;
    border: 2px solid #0f172a;
    border-radius: 50%;
    background: var(--rating-color);
    -webkit-appearance: none;
  }

  .mobile-filter-actions {
    display: grid;
    grid-template-columns: 0.75fr 1.25fr;
    gap: 10px;
  }

  .mobile-compact-list {
    display: none;
    width: calc(100% - 32px);
    margin: 12px 16px 32px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 11px;
    background: rgba(9, 18, 40, 0.78);
    animation: mobile-view-enter 0.18s ease-out;
  }

  .player-carousel-shell {
    animation: mobile-view-enter 0.18s ease-out;
  }

  .roster-view-stage[data-mobile-view='compact'] .player-carousel-shell {
    display: none;
  }

  .roster-view-stage[data-mobile-view='compact'] .mobile-compact-list {
    display: block;
  }

  .mobile-compact-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(68px, 96px) 30px 56px;
    align-items: center;
    gap: 7px;
    width: 100%;
    min-height: 46px;
    padding: 8px 10px 8px 12px;
    border: 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    background: transparent;
    color: #fff;
    cursor: pointer;
    text-align: left;
  }

  .mobile-compact-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(68px, 96px) 30px 56px;
    gap: 7px;
    align-items: center;
    min-height: 30px;
    padding: 5px 10px 5px 12px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(15, 29, 61, 0.8);
  }

  .mobile-compact-header-button {
    display: inline-flex;
    min-width: 0;
    align-items: center;
    gap: 3px;
    padding: 0;
    border: 0;
    background: transparent;
    color: #64748b;
    cursor: pointer;
    font-family: 'Inter', sans-serif;
    font-size: 0.54rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .mobile-compact-header-button.align-right {
    justify-content: flex-end;
  }

  .mobile-compact-header-button.align-center {
    justify-content: center;
  }

  .mobile-compact-header-button > span:first-child {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .mobile-compact-header-button > span:last-child {
    width: 9px;
    color: #334155;
    font-size: 0.8rem;
  }

  .mobile-compact-header-button > span:last-child.active {
    color: #60a5fa;
  }

  .mobile-compact-row:last-of-type {
    border-bottom: 0;
  }

  .mobile-compact-row:active {
    background: rgba(59, 130, 246, 0.1);
  }

  .mobile-compact-row strong {
    min-width: 0;
    overflow: hidden;
    font-family: 'Oswald', sans-serif;
    font-size: 0.83rem;
    letter-spacing: 0.015em;
    text-overflow: ellipsis;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .mobile-compact-position {
    max-width: 96px;
    overflow: hidden;
    color: #7daee9;
    font-size: 0.59rem;
    font-weight: 700;
    text-overflow: ellipsis;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .mobile-compact-matches {
    color: #cbd5e1;
    font-size: 0.68rem;
    font-weight: 700;
    text-align: center;
  }

  .mobile-compact-goals,
  .mobile-compact-assists,
  .mobile-compact-header-button.column-goals,
  .mobile-compact-header-button.column-assists {
    display: none;
  }

  .mobile-compact-rating {
    display: inline-flex;
    width: 45px;
    min-width: 45px;
    min-height: 27px;
    align-items: center;
    justify-content: center;
    justify-self: end;
    padding: 2px 6px;
    border-radius: 6px;
    font-size: 0.7rem;
    font-weight: 700;
  }

  .mobile-filter-actions button {
    min-height: 42px;
    border-radius: 8px;
    font-family: 'Inter', sans-serif;
    font-size: 0.78rem;
    font-weight: 700;
  }

  .mobile-filter-reset {
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: transparent;
    color: #cbd5e1;
  }

  .mobile-filter-apply {
    border: 1px solid #3b82f6;
    background: #1d4ed8;
    color: #fff;
  }

  .app-header {
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    padding: 16px 16px 12px;
  }

  .brand h1 {
    font-size: 1.85rem;
    letter-spacing: 2px;
  }

  .brand .subtitle {
    font-size: 0.7rem;
    letter-spacing: 1.5px;
  }

  .tab-bar {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    white-space: nowrap;
    gap: 8px;
    padding-bottom: 6px;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .tab-bar::-webkit-scrollbar {
    display: none;
  }

  .tab-button {
    flex: 0 0 auto;
    padding: 8px 14px;
    font-size: 0.8rem;
  }


  /* Full-width swipe carousel: one readable card per viewport. */
  .player-grid {
    display: flex !important;
    flex-wrap: nowrap !important;
    overflow-x: auto !important;
    overflow-y: hidden !important;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior-x: contain;
    touch-action: pan-x pan-y;
    padding: 16px 5vw 28px !important;
    gap: 4vw !important;
    scroll-padding-inline: 5vw;
    scrollbar-width: none;
  }

  .player-grid::-webkit-scrollbar {
    display: none;
  }

  .mobile-swipe-hint {
    position: fixed;
    top: calc(clamp(148px, 20svh, 180px) + env(safe-area-inset-top));
    bottom: auto;
    left: 50%;
    z-index: 20;
    display: inline-flex;
    align-items: center;
    max-width: calc(100vw - 32px);
    padding: 8px 13px;
    border: 1px solid rgba(147, 197, 253, 0.42);
    border-radius: 999px;
    background: rgba(9, 17, 42, 0.94);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
    color: #dbeafe;
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    pointer-events: none;
    white-space: nowrap;
    transform: translateX(-50%);
    animation: mobile-swipe-hint 4.5s ease 0.5s forwards;
  }

  .mobile-swipe-hint > span:first-child {
    font-size: 0;
  }

  .mobile-swipe-hint > span:first-child::before {
    content: 'Swipe to browse. Tap for advanced stats.';
    font-size: 0.64rem;
  }

  .swipe-hint-arrow {
    display: none;
  }

  /* The flip container is the actual flex child / carousel slide. */
  .flip-container {
    flex: 0 0 90vw;
    width: 90vw;
    min-width: 0;
    scroll-snap-align: center;
    scroll-snap-stop: normal;
    user-select: none;
    -webkit-user-select: none;
  }

  /* Card Sizing & Vertical Distribution */
  .player-card {
    flex: 0 0 100% !important;
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    min-height: clamp(480px, 60vh, 560px) !important;
    display: flex !important;
    flex-direction: column !important;
    justify-content: flex-start !important;
  }

  .player-photo {
    width: 145px !important;
    height: 145px !important;
    margin-top: 32px !important;
    margin-bottom: 14px !important;
  }

  .player-card h2 {
    font-size: 1.6rem !important;
    margin-bottom: 8px !important;
  }

  .player-card .position {
    font-size: 0.7rem !important;
    margin: 16px 28px 10px !important;
    padding: 0;
  }

  .player-card .league {
    font-size: 0.9rem !important;
  }

  .player-card .team {
    font-size: 0.97rem !important;
  }

  .vitals {
    font-size: 0.9rem !important;
    margin-top: 16px !important;
    margin-bottom: auto !important;
  }

  .vital-label {
    font-size: 0.65rem;
  }

  .vital-value {
    font-size: 0.92rem;
  }

  .stats {
    margin-top: auto !important;
    padding: 4px 0 !important;
  }

  .stat-value {
    font-size: 1.07rem !important;
  }

  .stat-label {
    font-size: 0.68rem;
  }
}

/* Mid-height phones need a modest scale-up without crowding the card footer. */
@media (max-width: 640px) and (min-height: 760px) and (max-height: 899px) {
  .player-carousel-shell {
    height: calc(100svh - 130px);
  }

  .player-grid {
    height: 100%;
    align-items: center;
  }

  .card-front .player-photo {
    width: 145px !important;
    height: 145px !important;
    margin-top: 39px !important;
    margin-bottom: 17px !important;
  }

  .card-front h2 {
    font-size: 1.68rem !important;
    margin-bottom: 8px !important;
  }

  .card-front .league {
    font-size: 0.87rem !important;
  }

  .card-front .team {
    font-size: 0.93rem !important;
  }

  .card-front .position {
    font-size: 0.69rem !important;
    margin-top: 17px !important;
    margin-bottom: 11px !important;
  }
}

/* Center and fully scale cards on genuinely tall phones. */
@media (max-width: 640px) and (min-height: 900px),
       (max-width: 640px) and (min-width: 400px) and (min-height: 760px) {
  .player-carousel-shell {
    height: calc(100svh - 130px);
  }

  .player-grid {
    height: 100%;
    align-items: center;
  }

  .vitals {
    margin-top: 0;
    margin-bottom: 18px;
    transform: translateY(8px);
  }

  .player-card .stats {
    margin-top: auto;
  }

  .card-front .player-photo {
    width: 156px !important;
    height: 156px !important;
    margin-top: 42px !important;
    margin-bottom: 18px !important;
  }

  .card-front h2 {
    font-size: 1.8rem !important;
    margin-top: 14px;
    margin-bottom: 9px !important;
  }

  .card-front .league {
    font-size: 0.92rem !important;
    margin-bottom: 5px;
  }

  .card-front .team {
    font-size: 0.98rem !important;
  }

  .card-front .position {
    font-size: 0.72rem !important;
    margin-top: 19px !important;
    margin-bottom: 13px !important;
  }

  .card-front .vital-label {
    font-size: 0.65rem;
  }

  .card-front .vital-value {
    font-size: 0.92rem;
  }

  .card-front .stats {
    padding: 8px 0 !important;
  }

  .card-front .stat {
    padding-top: 15px;
    padding-bottom: 15px;
  }

  .card-front .stat-label {
    font-size: 0.68rem;
  }

  .card-front .stat-value {
    font-size: 1.12rem !important;
  }
}

/* Scale the mobile front card with its 90vw carousel width. */
@media (max-width: 640px), (orientation: landscape) and (max-height: 500px) and (max-width: 950px) {
  .card-front.player-card {
    min-height: clamp(516px, 138vw, 594px) !important;
  }

  .card-front .player-photo {
    width: clamp(153px, 40.8vw, 176px) !important;
    height: clamp(153px, 40.8vw, 176px) !important;
    margin-top: clamp(33px, 8.8vw, 38px) !important;
    margin-bottom: clamp(14px, 3.8vw, 16px) !important;
  }

  .card-front h2 {
    font-size: clamp(1.78rem, 7.62vw, 2.05rem) !important;
    margin-top: clamp(14px, 3.75vw, 16px) !important;
    margin-bottom: clamp(8px, 2.1vw, 9px) !important;
  }

  .card-front .league {
    font-size: clamp(1.04rem, 4.52vw, 1.21rem) !important;
  }

  .card-front .team {
    font-size: clamp(1.13rem, 4.86vw, 1.3rem) !important;
  }

  .card-front .position {
    font-size: clamp(0.81rem, 3.5vw, 0.94rem) !important;
    margin-top: clamp(19px, 5.05vw, 22px) !important;
    margin-bottom: clamp(12px, 3.2vw, 14px) !important;
  }

  .card-front .vitals {
    gap: clamp(10px, 2.8vw, 12px);
    margin-top: clamp(18px, 4.8vw, 21px) !important;
    transform: translateY(-3px);
  }

  .card-front .vital {
    gap: clamp(5px, 1.4vw, 6px);
  }

  .card-front .vital-label {
    font-size: clamp(0.76rem, 3.28vw, 0.88rem);
  }

  .card-front .vital-value {
    font-size: clamp(1.07rem, 4.63vw, 1.24rem);
  }

  .card-front .stats {
    padding: clamp(5px, 1.4vw, 6px) 0 !important;
  }

  .card-front .stat {
    padding: clamp(17px, 4.55vw, 20px) 2px;
  }

  .card-front .stat-label {
    font-size: clamp(0.78rem, 3.4vw, 0.91rem);
  }

  .card-front .stat-value {
    font-size: clamp(1.24rem, 5.36vw, 1.44rem) !important;
  }

  .card-front .stat-rating {
    width: 58px;
    min-height: 36px;
    padding: 3px 4px;
    line-height: 1;
  }
}

/* Keep SE-class screens comfortably inside the usable mobile viewport. */
@media (max-width: 390px) and (max-height: 700px) {
  .app-header {
    gap: 10px;
    padding: 13px 16px 9px;
  }

  .player-grid {
    padding-top: 10px !important;
    padding-bottom: 18px !important;
  }

  .card-front .vitals {
    transform: translateY(-4px);
  }
}

@media (max-width: 420px) {
  .mobile-filter-label {
    display: none;
  }

  .mobile-filter-trigger {
    gap: 5px;
    padding-inline: 8px;
  }
}

@media (orientation: landscape) and (max-height: 500px) and (max-width: 950px) {
  .app-header {
    gap: 8px;
    padding: 10px 16px 8px;
  }

  .brand h1 {
    font-size: 1.5rem;
  }

  .brand .subtitle {
    font-size: 0.6rem;
  }

  .tab-bar {
    padding-bottom: 2px;
  }

  .tab-button {
    padding: 6px 10px;
    font-size: 0.7rem;
  }

  .mobile-filter-bar {
    top: 10px;
  }

  .mobile-view-trigger {
    display: none;
  }

  .player-carousel-shell {
    display: none !important;
  }

  .mobile-compact-list {
    display: block !important;
    margin-top: 8px;
  }

  .mobile-compact-rating {
    width: 45px;
    min-width: 45px;
    min-height: 24px;
    padding: 1px 5px;
    font-size: 0.66rem;
  }

  .mobile-compact-header,
  .mobile-compact-row {
    grid-template-columns: minmax(0, 1fr) minmax(90px, 130px) 38px 34px 34px 60px;
  }

  .mobile-compact-goals,
  .mobile-compact-assists,
  .mobile-compact-header-button.column-goals,
  .mobile-compact-header-button.column-assists {
    display: inline-flex;
  }

  .mobile-compact-goals,
  .mobile-compact-assists {
    justify-content: center;
    color: #cbd5e1;
    font-size: 0.68rem;
    font-weight: 700;
    text-align: center;
  }

  .mobile-compact-row {
    min-height: 42px;
    padding-block: 6px;
  }

  .mobile-filter-sheet {
    max-height: calc(100svh - 8px);
    overflow-y: auto;
  }
}

@keyframes mobile-view-enter {
  from {
    opacity: 0;
    transform: translateY(4px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (prefers-reduced-motion: reduce) {
  .mobile-compact-list,
  .player-carousel-shell {
    animation: none;
  }
}

@keyframes mobile-filter-sheet-in {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

@keyframes mobile-swipe-hint {
  0%, 72% {
    opacity: 1;
  }
  100% {
    opacity: 0;
    transform: translate(-50%, -6px);
  }
}

@keyframes swipe-hint-arrow {
  from { transform: translateX(-1px); }
  to { transform: translateX(3px); }
}

/* Card flip and back */

.flip-container {
  perspective: 1000px;
  width: 100%;
  border-radius: 20px;
  cursor: pointer;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.flip-container:hover,
.flip-container.is-active {
  transform: translateY(-8px);
  box-shadow: 0 22px 40px rgba(0, 0, 0, 0.8), 0 0 20px rgba(37, 99, 235, 0.3);
}

.flip-inner {
  position: relative;
  width: 100%;
  height: 100%;
  transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  transform-style: preserve-3d;
}

.flip-inner.is-flipped {
  transform: rotateY(180deg);
}

/* The front remains in normal flow to establish card height. */
.card-front {
  position: relative;
  width: 100%;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}

.card-front:hover, 
.card-front.is-active {
  transform: none !important;
  box-shadow: none !important;
}

.card-back {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  transform: rotateY(180deg);
  overflow: hidden;
  
  background: linear-gradient(165deg, #070d1e 0%, #0d1838 100%);
  border: 1px solid rgba(59, 130, 246, 0.4);
  border-radius: 20px;
  display: flex;
  flex-direction: column;
  padding: 16px 14px 12px 14px;
  box-sizing: border-box;
}

.card-back::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4px;
  background: linear-gradient(90deg, #dc2626 0%, #ffffff 50%, #2563eb 100%);
  z-index: 2;
}

.card-back-header {
  display: flex;
  flex-direction: column;
  gap: 2px;
  padding-bottom: 6px;
  margin-bottom: 6px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  width: 100%;
  text-align: left;
}

.back-player-name {
  font-family: 'Oswald', sans-serif;
  font-size: 1.25rem;
  font-weight: 700;
  color: #ffffff;
  text-transform: uppercase;
  margin: 0;
  line-height: 1.1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  width: 100%;
}

.back-league {
  font-size: 0.725rem;
  font-weight: 700;
  text-transform: uppercase;
  color: #93c5fd;
  letter-spacing: 1px;
  margin: 0;
  line-height: 1.2;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  width: 100%;
}

.back-team {
  font-size: 0.775rem;
  color: #94a3b8;
  margin: 0;
  line-height: 1.2;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  width: 100%;
}

.stats-control-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  justify-content: flex-end;
  margin-bottom: 5px;
}

.control-label {
  font-family: 'Oswald', sans-serif;
  font-size: 0.75rem;
  color: #64748b;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.season-dropdown {
  background: rgba(15, 23, 42, 0.9);
  color: #ffffff;
  border: 1px solid rgba(255, 255, 255, 0.18);
  border-radius: 6px;
  padding: 2px 6px;
  font-family: 'Inter', sans-serif;
  font-size: 0.725rem;
  font-weight: 600;
  cursor: pointer;
  outline: none;
  transition: border-color 0.2s, background 0.2s;
}

.season-dropdown:hover,
.season-dropdown:focus {
  border-color: #3b82f6;
  background: rgba(30, 41, 59, 0.95);
}

.card-filter-selects {
  display: flex;
  align-items: center;
  flex: 1;
  justify-content: stretch;
  gap: 6px;
  min-width: 0;
}

.card-filter-selects .season-dropdown {
  flex: 0 0 108px;
}

.competition-dropdown {
  min-width: 0;
  flex: 1;
  background: rgba(15, 23, 42, 0.75);
  border: 1px solid rgba(255, 255, 255, 0.13);
  border-radius: 5px;
  color: #cbd5e1;
  cursor: pointer;
  font-family: 'Inter', sans-serif;
  font-size: 0.68rem;
  font-weight: 600;
  outline: none;
  padding: 3px 6px;
}

.competition-dropdown:hover,
.competition-dropdown:focus {
  border-color: #3b82f6;
}

.advanced-stats-container {
  position: relative;
  flex: 1 1 0;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  min-height: 0;
  width: 100%;
  margin: 2px 0 0;
}

.placeholder-text {
  color: #64748b;
  font-size: 0.85rem;
}

.competition-loading {
  flex: 1;
  display: flex;
  min-height: 0;
  flex-direction: column;
  justify-content: center;
  gap: 14px;
  padding: 8px 2px 12px;
  color: #64748b;
  font-size: 0.76rem;
  text-align: center;
}

.competition-loading-label {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  color: #94a3b8;
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

.competition-loading-spinner {
  width: 14px;
  height: 14px;
  border: 2px solid rgba(96, 165, 250, 0.2);
  border-top-color: #60a5fa;
  border-radius: 50%;
  animation: competition-spin 0.8s linear infinite;
}

.competition-loading-skeleton {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.competition-skeleton-row {
  display: grid;
  grid-template-columns: minmax(80px, 0.7fr) 34px;
  gap: 10px;
}

.competition-skeleton-row span,
.competition-skeleton-row strong,
.competition-skeleton-row i {
  position: relative;
  height: 10px;
  overflow: hidden;
  border-radius: 999px;
  background: rgba(148, 163, 184, 0.11);
}

.competition-skeleton-row strong {
  justify-self: end;
  width: 30px;
}

.competition-skeleton-row i {
  grid-column: 1 / -1;
  width: 100%;
  height: 12px;
}

.competition-skeleton-row span::after,
.competition-skeleton-row strong::after,
.competition-skeleton-row i::after {
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, transparent, rgba(96, 165, 250, 0.17), transparent);
  content: '';
  transform: translateX(-100%);
  animation: competition-shimmer 1.35s ease-in-out infinite;
}

@keyframes competition-spin {
  to { transform: rotate(360deg); }
}

@keyframes competition-shimmer {
  to { transform: translateX(100%); }
}

.flip-hint {
  text-align: center;
  font-size: 0.68rem;
  color: #475569;
  text-transform: uppercase;
  letter-spacing: 1px;
  margin-top: auto;
  padding-top: 6px;
}

.adv-grid {
  display: flex;
  flex-direction: column;
  gap: 5px;
  width: 100%;
}

.adv-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: rgba(15, 23, 42, 0.6);
  border: 1px solid rgba(255, 255, 255, 0.08);
  padding: 5px 8px;
  border-radius: 6px;
  font-size: 0.775rem;
}

.adv-label {
  color: #94a3b8;
  font-weight: 500;
}

.adv-val {
  color: #ffffff;
  font-weight: 700;
  font-family: 'Oswald', sans-serif;
  letter-spacing: 0.5px;
}

/* Base Stats Banner */
.base-stats-banner {
  display: grid;
  grid-template-columns: 1fr 1.28fr 0.7fr 0.7fr;
  align-items: center;
  background: rgba(255, 255, 255, 0.07);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 6px;
  padding: 7px 6px;
  margin: 3px 0 7px;
  font-size: 0.78rem;
}

.banner-item {
  display: flex;
  align-items: center;
  gap: 4px;
  justify-content: flex-start;
  padding: 0 8px;
  white-space: nowrap;
}

.banner-item:not(:last-child) {
  border-right: 1px solid rgba(255, 255, 255, 0.1);
}

.banner-item span {
  color: #a0aec0;
  font-size: 0.66rem;
  font-weight: 700;
  letter-spacing: 0.04em;
}

.banner-item strong {
  color: #ffffff;
  font-weight: 700;
  font-size: 0.83rem;
  line-height: 1;
}

.metric-mode-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  margin: 0 1px 3px;
}

.metric-mode-bar > span {
  color: #64748b;
  font-size: 0.59rem;
  font-weight: 700;
  letter-spacing: 0.07em;
  text-transform: uppercase;
}

.metric-mode-toggle {
  display: inline-flex;
  padding: 1px;
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 6px;
  background: rgba(15, 23, 42, 0.8);
}

.metric-mode-toggle button {
  min-height: 20px;
  padding: 2px 6px;
  border: 0;
  border-radius: 4px;
  background: transparent;
  color: #64748b;
  cursor: pointer;
  font-family: 'Inter', sans-serif;
  font-size: 0.54rem;
  font-weight: 700;
  text-transform: uppercase;
}

.metric-mode-toggle button:hover,
.metric-mode-toggle button:focus-visible {
  color: #dbeafe;
  outline: none;
}

.metric-mode-toggle button.active {
  background: #1d4ed8;
  color: #fff;
}

/* Advanced Metrics List Table */
.advanced-metrics-list {
  display: flex;
  flex: 0 0 auto;
  flex-direction: column;
  gap: 0;
  min-width: 0;
  min-height: 0;
  overflow: visible;
  padding: 0;
}

.metrics-header-row {
  display: none;
}

.metrics-header-row .align-right {
  text-align: right;
}

.metric-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  column-gap: 8px;
  row-gap: 5px;
  align-items: center;
  min-width: 0;
  min-height: 0;
  padding: 4px 2px 7px;
  border-bottom: 0;
}

.metric-row + .metric-row {
  margin-top: 2px;
}

.metric-label {
  color: #e2e8f0;
  font-size: 0.78rem;
  font-weight: 600;
  line-height: 1.08;
  min-width: 0;
  overflow-wrap: anywhere;
  text-align: left;
}

.metric-value {
  color: #ffffff;
  font-size: 0.76rem;
  font-weight: 700;
  text-align: right;
  white-space: nowrap;
  padding: 0;
}

.percentile-cell {
  display: flex;
  justify-content: flex-end;
  grid-column: 1 / -1;
  min-width: 0;
  width: 100%;
}

.percentile-bar {
  position: relative;
  width: 100%;
  height: 13px;
  overflow: hidden;
  border: 1px solid rgba(255, 255, 255, 0.13);
  border-radius: 999px;
  background: rgba(148, 163, 184, 0.13);
}

.percentile-fill {
  position: absolute;
  inset: 0 auto 0 0;
  border-radius: inherit;
  opacity: 0.92;
}

.percentile-score {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  padding: 0 3px;
  color: #ffffff;
  font-size: 0.67rem;
  font-weight: 700;
  line-height: 1;
  text-align: center;
  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.75);
}

.mobile-percentile-score {
  display: none;
}

.mobile-per-90 {
  display: inline;
  color: #94a3b8;
  font-size: 0.64rem;
  font-weight: 600;
}

.percentile-unavailable {
  width: 100%;
  color: #64748b;
  font-size: 0.85rem;
  font-weight: 700;
  text-align: center;
}

/* Historical Summary Mode Grid */
.historical-stats-container {
  padding: 4px 0;
  flex-grow: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.historical-summary-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 8px;
}

.hist-stat-box {
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 8px;
  padding: 8px 6px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.hist-label {
  font-size: 0.65rem;
  color: #a0aec0;
  margin-bottom: 2px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.hist-value {
  font-size: 1.05rem;
  font-weight: 700;
  color: #ffffff;
}

.hist-value.rating-none,
.hist-value.rating-t1,
.hist-value.rating-t2,
.hist-value.rating-t3,
.hist-value.rating-t4,
.hist-value.rating-t5 {
  padding: 2px 8px;
  border-radius: 5px;
  font-size: 0.95rem;
}

/* Fit all five advanced metrics on the shorter desktop card back. */
@media (min-width: 641px) {
  .card-back {
    padding: 12px 14px 8px;
  }

  .card-back-header {
    gap: 1px;
    padding-bottom: 4px;
    margin-bottom: 4px;
  }

  .stats-control-bar {
    margin-bottom: 3px;
  }

  .base-stats-banner {
    padding-block: 5px;
    margin: 2px 0 5px;
  }

  .metric-mode-bar {
    margin-bottom: 2px;
  }

  .metric-mode-toggle button {
    min-height: 19px;
    padding-block: 1px;
  }

  .metric-row {
    row-gap: 3px;
    padding: 2px 2px 4px;
  }

  .metric-label {
    font-size: 0.71rem;
    line-height: 1;
  }

  .metric-row + .metric-row {
    margin-top: 1px;
  }

  .percentile-bar {
    height: 12px;
  }
}

/* Mobile card back */
@media (max-width: 640px), (orientation: landscape) and (max-height: 500px) and (max-width: 950px) {
  .card-back {
    padding: 13px 12px 10px;
  }

  .back-player-name {
    font-size: 1.15rem;
  }

  .back-league {
    font-size: 0.68rem;
  }

  .back-team {
    font-size: 0.72rem;
  }

  .stats-control-bar {
    margin-bottom: 6px;
  }

  .card-filter-selects {
    gap: 5px;
  }

  .card-filter-selects .season-dropdown {
    flex-basis: 104px;
  }

  .season-dropdown,
  .competition-dropdown {
    min-height: 32px;
    font-size: 0.72rem;
    padding: 4px 6px;
  }

  .base-stats-banner {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    padding: 7px 0;
    margin-bottom: 6px;
  }

  .metric-mode-bar {
    margin-bottom: 3px;
  }

  .metric-mode-toggle button {
    min-height: 22px;
    padding: 2px 7px;
    font-size: 0.56rem;
  }

  .banner-item {
    flex-direction: column;
    gap: 2px;
    justify-content: center;
    padding: 0 3px;
    text-align: center;
  }

  .banner-item span {
    font-size: 0.56rem;
    letter-spacing: 0.06em;
  }

  .banner-item strong {
    font-size: 0.88rem;
  }

  .metrics-header-row {
    display: none;
  }

  .metric-row {
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: 8px;
    row-gap: 5px;
    min-height: 0;
    padding: 4px 2px 7px;
  }

  .metric-label {
    font-size: 0.76rem;
    line-height: 1.1;
    overflow-wrap: normal;
    white-space: nowrap;
    text-align: left;
  }

  .metric-value {
    font-size: 0.76rem;
  }

  .mobile-per-90 {
    display: inline;
    color: #94a3b8;
    font-size: 0.64rem;
    font-weight: 600;
  }

  .percentile-cell {
    grid-column: 1 / -1;
    width: 100%;
  }

  .percentile-bar {
    height: 13px;
  }

  .percentile-score {
    font-size: 0.62rem;
  }

  .desktop-percentile-score {
    display: none;
  }

  .mobile-percentile-score {
    display: inline;
  }

  .advanced-metrics-list {
    padding-bottom: 0;
    overflow: visible;
  }

  .flip-hint {
    font-size: 0.6rem;
    padding-top: 5px;
  }
}

/* Keep table-launched stats inside the viewport after mobile card sizing rules. */
@media (max-width: 640px), (orientation: landscape) and (max-height: 500px) and (max-width: 950px) {
  .player-stats-panel .card-front.player-card {
    min-height: min(594px, calc(100svh - 56px)) !important;
  }

  .card-front .stat-output .stat-label {
    font-size: clamp(0.67rem, 2.8vw, 0.76rem) !important;
  }

}
